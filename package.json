{
  "name": "SendinBeats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "logs:filter": "bash scripts/filter_logs.sh logs/output.log --f \"$KEYWORDS\" logs/filtered.log && cat logs/filtered.log",
    "logs:clean": "rm  -f logs/output.log && rm -f logs/filtered.log",
    "tauri": "RUSTFLAGS=\"-A warnings\" tauri",
    "tauri:dev": "clear && pnpm logs:clean && src-swift/build.sh && CARGO_TERM_COLOR=always FORCE_COLOR=1 pnpm tauri dev 2>&1 | tee -a logs/output.log",
    "tauri:release": "set -o pipefail && clear && pnpm logs:clean && src-swift/build.sh && CARGO_TERM_COLOR=always FORCE_COLOR=1 pnpm tauri build --bundles app 2>&1 | tee -a logs/output.log && ./src-tauri/target/release/bundle/macos/SendinBeats.app/Contents/MacOS/SendinBeats 2>&1 | tee -a logs/output.log",
    "test": "RUSTFLAGS=\"-A warnings\" cargo test  --manifest-path ./src-tauri/Cargo.toml",
    "test:rust": "RUSTFLAGS=\"-A warnings\" cargo test --verbose  --manifest-path ./src-tauri/Cargo.toml",
    "test:audio": "RUSTFLAGS=\"-A warnings\" cargo test audio  --manifest-path ./src-tauri/Cargo.toml",
    "test:watch": "RUSTFLAGS=\"-A warnings\" cargo watch -x test  --manifest-path ./src-tauri/Cargo.toml",
    "type-check": "tsc --noEmit",
    "lint": "node scripts/run-eslint.mjs",
    "lint:fix": "node scripts/run-eslint.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:check": "RUSTFLAGS=\"-A warnings\" cargo check  --manifest-path ./src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path ./src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path ./src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --all-targets --all-features  --manifest-path ./src-tauri/Cargo.toml",
    "migration": "node scripts/create-migration.cjs",
    "migrate": "cargo sqlx migrate run --source ./src-tauri/migrations --database-url sqlite:$HOME/.sendin_beats/data/sendin_beats.db",
    "quality": "turbo run quality",
    "quality:fix": "turbo run quality:fix",
    "pre-commit": "turbo run pre-commit",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tabler/icons-react": "^3.34.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^12.23.12",
    "lodash": "^4.17.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.0.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.33.0",
    "@tauri-apps/cli": "^2",
    "@types/lodash": "^4.17.20",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-config-mantine": "^4.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.6.2",
    "react-scan": "^0.4.3",
    "turbo": "^2.5.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.0.3"
  }
}
