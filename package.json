{
  "name": "SweetBeatsStudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "logs:filter": "bash scripts/filter_logs.sh logs/output.log --f \"$KEYWORDS\" logs/filtered.log && cat logs/filtered.log",
    "logs:clean": "rm  -f logs/output.log && rm -f logs/filtered.log",
    "tauri": "RUSTFLAGS=\"-A warnings\" tauri",
    "tauri:dev": "clear && pnpm logs:clean && make native && CARGO_TERM_COLOR=always FORCE_COLOR=1 pnpm tauri dev 2>&1 | tee -a logs/output.log",
    "tauri:release": "set -o pipefail && clear && pnpm logs:clean && make native && CARGO_TERM_COLOR=always FORCE_COLOR=1 pnpm tauri build --bundles app 2>&1 | tee -a logs/output.log && ./src-tauri/target/release/bundle/macos/SweetBeatsStudio.app/Contents/MacOS/SweetBeatsStudio 2>&1 | tee -a logs/output.log",
    "test": "RUSTFLAGS=\"-A warnings\" cargo test  --manifest-path ./src-tauri/Cargo.toml",
    "test:rust": "RUSTFLAGS=\"-A warnings\" cargo test --verbose  --manifest-path ./src-tauri/Cargo.toml",
    "test:audio": "RUSTFLAGS=\"-A warnings\" cargo test audio  --manifest-path ./src-tauri/Cargo.toml",
    "test:watch": "RUSTFLAGS=\"-A warnings\" cargo watch -x test  --manifest-path ./src-tauri/Cargo.toml",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix-dangerously",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:check": "RUSTFLAGS=\"-A warnings\" cargo check  --manifest-path ./src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path ./src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path ./src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --all-targets --all-features  --manifest-path ./src-tauri/Cargo.toml",
    "migration": "node scripts/create-migration.cjs",
    "migrate": "mkdir -p $HOME/.sweet_beats_studio/data && cargo sqlx migrate run --source ./src-tauri/migrations --database-url 'sqlite:'$HOME'/.sweet_beats_studio/data/sweet_beats_studio.db?mode=rwc'",
    "quality": "turbo run quality",
    "quality:fix": "turbo run quality:fix",
    "pre-commit": "turbo run pre-commit",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tabler/icons-react": "^3.34.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^12.23.12",
    "lodash": "^4.17.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.0.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/lodash": "^4.17.20",
    "@vitejs/plugin-react": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.6.2",
    "react-scan": "^0.4.3",
    "turbo": "^2.5.6",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
